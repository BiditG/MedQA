# Example environment variables for auth + Turso
JWT_SECRET=supersecret
TURSO_DB_URL=<your-turso-connection-url>
# For local dev (sqlite fallback). If provided, local DB will be created at this path.
SQLITE_DB_PATH=./data/auth.db
PORT=4000
# If you want the server to also set an HttpOnly cookie named `token` on login, set:
SET_AUTH_COOKIE=1
# Copy this file to .env.local and set your OpenFDA API key
# Do NOT commit your actual key to git
# Example:
# OPENFDA_KEY=YFHqgDQ8OUTwiLes1zgc4lVGXogOgNj8FV5asvjI

OPENFDA_KEY=
